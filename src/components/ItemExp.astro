---
import { Image } from 'astro:assets';

interface Props {
    title: string;
    logo: ImageMetadata;
}
const { title, logo } = Astro.props;
---

<div class="col-span-1 flex items-center justify-center mr-2 md:mr-4">
    <Image class="mt-5 rounded-sm" src={logo} alt="" />
</div>
<!-- ------- -->
<div class="col-span-1">
    <div class="w-0.5 dark:bg-orange-400 bg-purple-600 h-full mx-auto relative">
        <div class="w-5 h-5 dark:bg-orange-400 bg-purple-600 rounded-full absolute top-[50%] -left-[9px]"></div>
    </div>
</div>
<!-- ------- -->
<div class="col-span-1 py-4 pl-2 md:p-4">
    <h3 class="font-medium mb-4">{title}</h3>
    <slot />
</div>