---
const { type, id, label } = Astro.props;
---
<button id={id} type="button" role="switch" aria-checked="false" aria-label={label} class="relative w-20 h-8 bg-blue-200 border-b-cyan-500 dark:bg-indigo-950 dark:border-violet-900 rounded-2xl flex items-center justify-between px-2.5 cursor-pointer select-none">
    <span class="absolute left-1 top-1 w-8 h-6 bg-blue-500 dark:bg-violet-900 rounded-2xl transition-transform duration-300 ease-in-out translate-x-[40px] dark:translate-x-0"></span>
    <slot />
</button>
  