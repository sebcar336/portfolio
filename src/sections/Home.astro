---
import { Image } from 'astro:assets';
import Tag from '../components/Tag.astro';
import yo from '../assets/images/yo.webp';
---

<section class="flex flex-col md:flex-row items-center justify-center gap-8 min-h-svh px-6 pb-40 text-white w-full bg-gradient-to-b dark:from-purple-950 dark:to-slate-950 from-indigo-400 to-zinc-300">
    <Image src={yo} width={384} alt="Sebastian Cardoso" loading="eager" fetchpriority="high" class="w-40 md:w-48 object-contain shadow-lg rounded-2xl" />
    <div class="flex flex-col items-center md:items-start justify-center text-center md:text-left">
        <h1 class="text-3xl md:text-4xl font-bold dark:text-BM-text text-WM-text">Hola, soy <span class="dark:text-orange-400 text-purple-950">Sebastian Cardoso</span></h1>
        <p class="text-xl md:text-2xl dark:text-purple-300 text-purple-950 mb-3.5 font-medium">Técnico en desarrollo de Software</p>
        <p class="max-w-105 dark:text-BM-text text-WM-text font-medium">Con una mirada innovadora, no hay límites para explorar nuevas formas de ver y construir el mundo.</p>
        <div class="flex flex-wrap justify-center gap-x-4">
            <Tag text='Disponible para trabajar' color='border-green-500 bg-green-500' />
            <Tag text='+1 Año de experiencia' color='border-orange-400 bg-orange-400' />
        </div>
    </div>
</section>
