---
import ItemSkills from '../components/ItemSkills.astro';
import IconGit from '../components/icons/skills/IconGit.astro';
import IconGithub from '../components/icons/social/IconGithub.astro';
import IconAstro from '../components/icons/skills/IconAstro.astro';
import IconTailwind from '../components/icons/skills/IconTailwind.astro';
import IconHTML from '../components/icons/skills/IconHTML.astro';
import IconCSS from '../components/icons/skills/IconCSS.astro';
import IconJs from '../components/icons/skills/IconJs.astro';
import IconReact from '../components/icons/skills/IconReact.astro';
import IconChromeExtensions from '../components/icons/skills/IconChromeExtensions.astro';
import IconAWS from "../components/icons/skills/IconAWS.astro";
import IconAzure from "../components/icons/skills/IconAzure.astro";
import IconUSA from "../components/icons/skills/IconUSA.astro";
import IconFigma from "../components/icons/skills/IconFigma.astro";
import IconClipchamp from "../components/icons/skills/IconClipchamp.astro";
import IconPython from "../components/icons/skills/IconPython.astro";
import IconNodeJs from "../components/icons/skills/IconNodeJs.astro";
import IconMySQL from "../components/icons/skills/IconMySQL.astro";
import IconPowerAutomate from "../components/icons/skills/IconPowerAutomate.astro";
import IconApi from "../components/icons/skills/IconApi.astro";
import IconCPlusPlus from "../components/icons/skills/IconCPlusPlus.astro"; 
import IconAWSBedrock from "../components/icons/skills/IconAWSBedrock.astro";
import IconHuggingFace from "../components/icons/skills/IconHuggingFace.astro";
import IconAzureAI from "../components/icons/skills/IconAzureAI.astro";
import IconCopilotStudio from "../components/icons/skills/IconCopilotStudio.astro";
import { useTranslations } from "../i18n/ui";

const t = useTranslations(Astro.currentLocale);
---
<h2 class="mb-10 px-4 text-3xl md:text-4xl text-center font-extrabold">{t.skills.title}</h2>
<div class="group grid grid-cols-1 md:grid-cols-2 xl:grid-cols-[300px_300px_200px_300px] xl:grid-rows-[auto_auto_auto] gap-2 w-full max-w-xl md:max-w-4xl xl:max-w-none xl:w-fit px-4 xl:px-0">
    <ItemSkills 
    title={t.skills.frontend.title}
    description={t.skills.frontend.description}
    class_icons="xl:col-start-3 xl:grid-cols-3 xl:grid-rows-3"
    classlist="xl:col-span-2 flex flex-col items-start"
    class_content="xl:grid xl:grid-cols-[70%_1fr]">
        <IconAstro size="w-10 h-10 col-start-2" color="text-WM-text dark:text-BM-text"/>
        <IconHTML size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconTailwind size="w-10 h-10 col-start-2" color="text-WM-text dark:text-BM-text"/>
        <IconCSS size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconChromeExtensions size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconReact size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconJs size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
    </ItemSkills>

    <ItemSkills 
    title={t.skills.agile.title}
    description={t.skills.agile.description}
    class_icons="xl:col-start-3 xl:grid-cols-1 xl:grid-rows-1 xl:mt-12"
    classlist="xl:col-span-2 xl:col-start-3 flex flex-col items-start"
    class_content="xl:grid xl:grid-cols-[80%_1fr]">
        <IconGit size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconGithub size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
    </ItemSkills>

    <ItemSkills 
    title={t.skills.ai.title}
    description={t.skills.ai.description}
    class_icons="xl:row-start-2 xl:grid-cols-[1fr_1fr] xl:grid-rows-[1fr_1fr] xl:h-fit xl:w-fit xl:ml-auto xl:mt-12"
    classlist="xl:row-span-2 xl:row-start-2"
    class_content="xl:grid xl:grid-rows-[1fr_w-fit]">
        <IconAWSBedrock size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconHuggingFace size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconAzureAI size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconCopilotStudio size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>  
    </ItemSkills>

    <ItemSkills 
    title={t.skills.backend.title}
    description={t.skills.backend.description}
    class_icons="xl:col-start-3 xl:grid-rows-[1fr_1fr_1fr] xl:grid-cols-[1fr_1fr] xl:h-fit xl:w-fit xl:ml-auto xl:mt-12"
    classlist="xl:col-span-2 xl:col-start-2 xl:row-start-2 flex flex-col items-start"
    class_content="xl:grid xl:grid-cols-[70%_1fr]">
        <IconPython size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconNodeJs size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconCPlusPlus size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconMySQL size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconApi size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconPowerAutomate size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
    </ItemSkills>

    <ItemSkills 
    title={t.skills.cloud.title}
    description={t.skills.cloud.description}
    class_icons="xl:row-start-2 xl:grid-cols-[1fr_1fr] xl:h-fit xl:w-fit xl:ml-auto"
    classlist="xl:col-start-4"
    class_content="xl:grid xl:grid-rows-[1fr_h-fit] xl:gap-2">
        <IconAWS size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconAzure size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
    </ItemSkills>

    <ItemSkills 
    title={t.skills.languages.title}
    description={t.skills.languages.description}
    class_icons="xl:row-start-2 xl:grid-cols-1 xl:h-fit xl:w-fit xl:ml-auto xl:mt-2"
    classlist="xl:col-start-2 xl:row-start-3"
    class_content="xl:grid xl:grid-rows-[1fr_h-fit] xl:gap-2">
        <IconUSA size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
    </ItemSkills>

    <ItemSkills 
    title={t.skills.design.title}
    description={t.skills.design.description}
    class_icons="xl:col-start-3 xl:grid-cols-[1fr_1fr] xl:h-fit xl:w-fit xl:ml-auto xl:mt-25"
    classlist="xl:col-span-2 xl:col-start-3 xl:row-start-3"
    class_content="xl:grid xl:grid-rows-[auto_1fr_auto] xl:h-full">
        <IconFigma size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
        <IconClipchamp size="w-10 h-10" color="text-WM-text dark:text-BM-text"/>
    </ItemSkills>
</div>    